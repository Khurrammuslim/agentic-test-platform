{
  "name": "agentic-test-platform-demo",
  "version": "1.0.0",
  "scripts": {
    "test:smoke": "playwright test --project=smoke",
    "test:regression": "playwright test --project=regression",
    "quarantine:check": "tsx scripts/quarantine-check.ts",
    "generate": "tsx scripts/generate-test.ts",
    "judge": "tsx scripts/judge.ts",
    "kpi": "tsx scripts/kpi-report.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "review-draft": "tsx scripts/review-draft.ts",
    "heal": "tsx scripts/heal-proposal.ts"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": "prettier --write"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
